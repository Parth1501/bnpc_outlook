---
interface Props {
  value: number;
  /** Hex or CSS color for the bar fill (from conviction helper). */
  accentColor?: string;
}

const { value, accentColor } = Astro.props;
const clamped = Math.max(0, Math.min(100, value));
const fallbackTone = clamped >= 70 ? 'var(--up)' : clamped >= 50 ? 'var(--moderate-impact)' : 'var(--down)';
const tone = accentColor ?? fallbackTone;
---

<div class="mt-3 w-24">
  <div class="h-1.5 rounded-full" style="background: var(--border);">
    <div class="h-1.5 rounded-full transition-all" style={`width: ${clamped}%; background: ${tone};`}></div>
  </div>
  <div class="mono text-[10px] text-center mt-1" style="color: var(--text-muted);">
    {clamped} / 100
  </div>
</div>
