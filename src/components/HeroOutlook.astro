---
import type { DailyAnalysis } from '../lib/types';
import ImpactBadge from './ImpactBadge.astro';
import ConfidenceBar from './ConfidenceBar.astro';
import { fmtDate } from '../lib/format';
import { getConvictionBucket } from '../lib/conviction';

interface Props {
  analysis: DailyAnalysis;
  lastUpdatedIst?: string;
}
const { analysis, lastUpdatedIst = '' } = Astro.props;

const openingConviction = getConvictionBucket(analysis.confidence);
const fullDayConviction = getConvictionBucket(analysis.full_day_confidence);

type BiasTone = 'bull' | 'bear' | 'neutral';
type Bias = DailyAnalysis['overall_bias'];

function biasTone(b: Bias): BiasTone {
  if (b === 'Bullish' || b === 'Strongly Bullish') return 'bull';
  if (b === 'Bearish' || b === 'Strongly Bearish') return 'bear';
  return 'neutral';
}

function toneStyle(bias: Bias): { color: string; bg: string; border: string } {
  const tone = biasTone(bias);
  return {
    color: {
      bull: 'var(--bullish)',
      bear: 'var(--bearish)',
      neutral: 'var(--neutral)',
    }[tone],
    bg: {
      bull: 'var(--bullish-bg)',
      bear: 'var(--bearish-bg)',
      neutral: 'var(--neutral-bg)',
    }[tone],
    border: {
      bull: 'var(--bullish-border)',
      bear: 'var(--bearish-border)',
      neutral: 'var(--neutral-border)',
    }[tone],
  };
}

const biasIcon: Record<Bias, string> = {
  'Strongly Bullish': '↑↑',
  Bullish: '↑',
  Neutral: '—',
  Bearish: '↓',
  'Strongly Bearish': '↓↓',
};

const openingStyle = toneStyle(analysis.overall_bias);
const fullDayStyle = toneStyle(analysis.full_day_bias);
const gapCue = analysis.global_cues.find((cue) =>
  cue.name.toLowerCase().includes('gift') || cue.name.toLowerCase().includes('implied open')
);
const gapHint = gapCue
  ? `${gapCue.change_pct >= 0 ? '+' : ''}${gapCue.change_pct.toFixed(2)}% ${gapCue.source === 'proxy' ? 'proxy gap' : 'gap cue'}`
  : 'Gap cue unavailable';

const horizonLabel: Record<DailyAnalysis['bias_horizon'], string> = {
  open: 'Open (first prints)',
  morning_session: 'Morning session',
  full_day: 'Full session',
};

const biasConfidenceLabel: Record<DailyAnalysis['bias_confidence'], string> = {
  low: 'Low',
  medium: 'Medium',
  high: 'High',
};

const factorLabels: Array<{ key: keyof DailyAnalysis['bias_rationale']; label: string }> = [
  { key: 'news_tone', label: 'News tone' },
  { key: 'global_cues', label: 'Global cues' },
  { key: 'fii_dii', label: 'FII/DII' },
  { key: 'vix', label: 'VIX' },
  { key: 'calendar', label: 'Calendar' },
];

const METHODOLOGY =
  "Conviction (0–100) is a self-rated confidence in the editorial outlook. Label confidence describes opening-rubric alignment. Neither is a return probability, price target, or trading recommendation.";
---

<div class="card p-6 sm:p-8">
  <div class="flex items-center flex-wrap gap-2 mb-4">
    <span class="label">{fmtDate(analysis.date)}</span>
    <span class="label" style="color: var(--border);">·</span>
    <span class="label">BNPC Market Outlook</span>
    <span class="label" style="color: var(--border);">·</span>
    <span class="label">
      Updated
      <span data-role="last-updated" class="ml-1">{lastUpdatedIst || '—'}</span>
    </span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-3 mb-6">
    <section class="rounded-xl border p-4" style={`border-color: ${openingStyle.border}; background: ${openingStyle.bg};`}>
      <div class="label mb-2" style={`color: ${openingStyle.color};`}>Opening verdict</div>
      <div class="flex items-center justify-between gap-3">
        <div>
          <div class="text-lg font-bold leading-tight" style={`color: ${openingStyle.color};`}>
            {analysis.overall_bias}
          </div>
          <div class="text-[11px] mt-1" style="color: var(--text-muted);">
            {horizonLabel[analysis.bias_horizon]} · {gapHint}
          </div>
        </div>
        <div class="mono text-3xl font-black" style={`color: ${openingStyle.color};`}>
          {biasIcon[analysis.overall_bias]}
        </div>
      </div>
      <div class="mt-3 flex flex-wrap gap-2">
        <span class="mono text-[10px] font-semibold px-2 py-1 rounded border" style="border-color: var(--border); color: var(--text-muted);">
          Label conf. {biasConfidenceLabel[analysis.bias_confidence]}
        </span>
        <span class="mono text-[10px] font-semibold px-2 py-1 rounded border" style={`border-color: ${openingConviction.color}55; color: ${openingConviction.color};`}>
          {analysis.confidence}/100 {openingConviction.label}
        </span>
      </div>
    </section>

    <section class="rounded-xl border p-4" style={`border-color: ${fullDayStyle.border}; background: ${fullDayStyle.bg};`}>
      <div class="label mb-2" style={`color: ${fullDayStyle.color};`}>Full-day verdict</div>
      <div class="flex items-center justify-between gap-3">
        <div>
          <div class="text-lg font-bold leading-tight" style={`color: ${fullDayStyle.color};`}>
            {analysis.full_day_bias}
          </div>
          <p class="text-[11px] leading-relaxed mt-1" style="color: var(--text-secondary);">
            {analysis.full_day_rationale.one_line}
          </p>
        </div>
        <div class="mono text-3xl font-black" style={`color: ${fullDayStyle.color};`}>
          {biasIcon[analysis.full_day_bias]}
        </div>
      </div>
    </section>

    <section class="rounded-xl border p-4" style={`border-color: ${fullDayConviction.color}55; background: ${fullDayConviction.color}12;`}>
      <div class="label mb-2" style={`color: ${fullDayConviction.color};`}>Full-day conviction</div>
      <div class="flex items-baseline gap-2">
        <span class="mono text-3xl font-black" style={`color: ${fullDayConviction.color};`}>
          {analysis.full_day_confidence}
        </span>
        <span class="mono text-xs font-semibold" style="color: var(--text-muted);">/ 100</span>
      </div>
      <div class="text-sm font-semibold mt-1" style={`color: ${fullDayConviction.color};`}>
        {fullDayConviction.label}
      </div>
      <ConfidenceBar value={analysis.full_day_confidence} accentColor={fullDayConviction.color} />
    </section>
  </div>

  <h1 class="text-xl sm:text-2xl font-semibold leading-tight mb-3" style="color: var(--text-primary); letter-spacing: -0.02em;">
    {analysis.headline_call}
  </h1>

  <p class="text-sm leading-relaxed mb-5" style="color: var(--text-secondary);">
    {analysis.summary}
  </p>

  <p class="text-[11px] leading-relaxed mb-1 max-w-3xl" style="color: var(--text-muted);">
    {METHODOLOGY}
  </p>

  <div class="mt-4 rounded-lg border px-3 py-3 max-w-3xl" style="border-color: var(--border); background: color-mix(in srgb, var(--bg-elevated) 70%, transparent);">
    <div class="label mb-2">Opening bias — rubric</div>
    <p class="text-xs leading-relaxed mb-3" style="color: var(--text-secondary);">
      {analysis.bias_rationale.one_line}
    </p>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-[11px] mono">
      {factorLabels.map(({ key, label }) => (
        <div class="flex justify-between gap-2 border rounded px-2 py-1.5" style="border-color: var(--border);">
          <span style="color: var(--text-muted);">{label}</span>
          <span class="font-semibold uppercase" style="color: var(--text-secondary);">
            {analysis.bias_rationale[key]}
          </span>
        </div>
      ))}
    </div>
    <p class="mt-2 text-[10px] leading-relaxed" style="color: var(--text-muted);">
      Factors aligned with tag: <span class="font-semibold mono" style="color: var(--text-secondary);">{analysis.bias_rationale.factors_aligned}</span> / 5
    </p>
  </div>
</div>

<script>
  const lastUpdatedEl = document.querySelector('[data-role="last-updated"]');
  async function loadLastUpdated() {
    if (!lastUpdatedEl) return;
    try {
      const res = await fetch('/last-updated.json', { cache: 'no-store' });
      if (!res.ok) return;
      const data = await res.json();
      if (data && typeof data.last_updated_ist === 'string' && data.last_updated_ist.trim()) {
        lastUpdatedEl.textContent = data.last_updated_ist.trim();
      }
    } catch {
      // keep server-rendered fallback
    }
  }
  loadLastUpdated();
</script>
