---
import type { PolicyNote } from '../lib/types';

interface Props {
  notes: PolicyNote[];
}

const { notes = [] } = Astro.props;

const grouped = notes.reduce<Record<string, PolicyNote[]>>((acc, item) => {
  const fy = item.fy || 'FY Unknown';
  if (!acc[fy]) acc[fy] = [];
  acc[fy].push(item);
  return acc;
}, {});

const fyOrder = Object.keys(grouped).sort((a, b) => b.localeCompare(a));
---

<div class="card p-6">
  <div class="label mb-3">Official Policy & Tax Notes (By FY)</div>
  {notes.length === 0 ? (
    <p class="text-xs" style="color: var(--text-muted);">
      No official market policy updates found in the latest fetch window.
    </p>
  ) : (
    <div class="flex flex-col gap-4">
      {fyOrder.map((fy) => (
        <div class="card-elevated p-4">
          <div class="mono text-xs font-semibold mb-3" style="color: var(--accent);">{fy}</div>
          <div class="flex flex-col gap-2">
            {grouped[fy].map((n) => (
              <div class="card px-3 py-2.5">
                <div class="flex flex-wrap items-center gap-2 mb-1.5">
                  <span class="text-[10px] px-1.5 py-0.5 rounded border mono"
                    style="border-color: var(--border); color: var(--text-secondary); background: var(--bg-elevated);">
                    {n.authority}
                  </span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded border mono"
                    style="border-color: var(--neutral-border); color: var(--text-muted); background: var(--neutral-bg);">
                    {n.category}
                  </span>
                  <span class="text-[10px] mono" style="color: var(--text-muted);">
                    {n.effective_from ?? 'Effective date not specified'}
                  </span>
                </div>
                <div class="text-xs font-medium mb-1" style="color: var(--text-primary);">{n.title}</div>
                <div class="text-[11px] mb-1.5" style="color: var(--text-secondary);">{n.note}</div>
                <a href={n.source_url} target="_blank" rel="noopener noreferrer" class="text-[11px] underline"
                  style="color: var(--accent);">
                  Official source
                </a>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  )}
</div>

