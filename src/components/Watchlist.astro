---
import type { WatchlistItem } from '../lib/types';

interface Props { items: WatchlistItem[]; }
const { items } = Astro.props;
---

<div>
  <div class="label mb-3">Watchlist — Stocks in Focus</div>
  <div class="flex flex-col gap-2">
    {items.map((item) => (
      <div class="card px-4 py-3 border-l-2" style="border-left-color: var(--accent);">
        <div class="flex items-start gap-3">
          <span
            class="mono text-xs font-bold px-2 py-1 rounded flex-shrink-0"
            style="background: var(--accent-bg); color: var(--accent); border: 1px solid rgba(79,70,229,0.2);"
          >
            {item.symbol}
          </span>
          <div class="flex-1 min-w-0">
            <p class="text-xs leading-relaxed mb-1" style="color: var(--text-secondary);">
              {item.thesis}
            </p>
            <div class="flex items-start gap-1.5">
              <span class="mono text-[10px] font-bold" style="color: var(--accent);">Trigger:</span>
              <span class="text-[11px] italic" style="color: var(--text-muted);">{item.trigger}</span>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
