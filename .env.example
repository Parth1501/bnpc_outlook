OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
SITE_URL=https://yourdomain.com
MARKETAUX_KEY=
FINNHUB_API_KEY=

# ── GNews.io ─────────────────────────────────────────────────────────────────
# API key from gnews.io — if unset, GNews fetch is skipped entirely.
# Country is fixed in code as "In" for top-headlines (see fetch-news.ts).
# Request query order matches GNews docs: category, lang, country, max, apikey, from, to, page.
GNEWS_API_KEY=
# Number of pages to fetch (1..N). Each page can return up to GNEWS_MAX articles.
# GNews API hard-caps pagination at 1000 total articles.
# Job runs at 02:00 UTC; window is previous-day 10:00Z → current-day 02:00Z.
GNEWS_MAX_PAGE=10
# Articles per page (1–100; 100 is the API maximum).
GNEWS_MAX=100

# ── News output cap ───────────────────────────────────────────────────────────
# Maximum total items written to tmp/raw-news.json after merge + dedupe.
# Set to 0 for no cap (default). Increase if LLM token budget allows.
FETCH_NEWS_MAX_OUT=0

# ── Analyze LLM news limit ────────────────────────────────────────────────────
# How many news items to send to the LLM in analyze.ts.
# Unset or 0 = send all items (higher tokens and cost).
# Set to a positive integer (e.g. 60) to cap and reduce cost.
ANALYZE_NEWS_COMPACT_LIMIT=
